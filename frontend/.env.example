# Public. Baked into the client bundle at build time, so nothing secret here.
NEXT_PUBLIC_API_URL=https://api.loseweight.net/api
NEXT_PUBLIC_SITE_URL=https://loseweight.net

# Kimlik.az OAuth (PKCE). Not currently wired up in the UI.
NEXT_PUBLIC_WALLET_URL=https://kimlik.az
NEXT_PUBLIC_WALLET_API_URL=https://api.kimlik.az/api
NEXT_PUBLIC_WALLET_CLIENT_ID=

# The frontend holds no secrets. AI keys live in backend/.env, because the API
# owns the durable cache, the spend ledger and the refusal screen.
